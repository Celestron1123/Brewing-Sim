   <property name="text">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;The freshly pressed aguamiel is ready for fermentation!&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;Here, yeast is added. It eats the sugars of the juice, producing alcohol. The liquid slowly transforms from a sweet juice into a young, unrefined tequila.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:13pt; font-weight:700;&quot;&gt;Place the yeast in the small wooden vat or push the auto mix button before continuing. &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
