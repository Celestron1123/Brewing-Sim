   <property name="styleSheet">
    <string notr="true">color: white;
background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(100, 100, 100, 100),
        stop:1 rgba(30, 30, 30, 220)
    );    
border-radius: 20px;
padding: 5px;</string>
   </property>
   <property name="text">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;Instructions:&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;&lt;br/&gt;Use the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;slider above the barrels&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; to select your desired aging duration of &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;3&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;, or &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;5 years&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;, then click the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;Mature&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; button to begin the aging process.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;Did you know?&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt;&lt;br/&gt;Rum gains flavor, color, and smoothness as it ages in oak barrels. The wood releases natural compounds like vanillin and tannins, which deepen the spirit’s character over time. In warm tropical climates, this process happens more quickly, and more liquid is lost to evaporation. This is called the &lt;/span&gt;&lt;span style=&quot; font-size:11pt; font-weight:700;&quot;&gt;“angel’s share.”&lt;/span&gt;&lt;span style=&quot; font-size:11pt;&quot;&gt; Even without choosing a specific barrel type, the length of aging can significantly influence how the final rum tastes and feels. &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="alignment">
    <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
   </property>
