   <property name="styleSheet">
    <string notr="true">QPushButton {
    color: white;
    background-color: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #cd853f,  /* golden brown */
        stop: 1 #8B5A2B   /* deep brown */
    );
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #d99a5c,
        stop: 1 #a66a36
    );
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #5C4033,
        stop: 1 #3e2f23
    );
}

QPushButton:disabled {
    color: #cccccc;
    background-color: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #999999,
        stop: 1 #777777
    );
}
</string>
