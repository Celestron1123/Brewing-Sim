   <property name="styleSheet">
    <string notr="true">QPushButton {
    /* Base style */
    color: white;
    background-color: qlineargradient(
        x1: 0, y1: 0, 
        x2: 0, y2: 1, 
        stop: 0 #5cb85c, 
        stop: 1 #4cae4c);
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton:hover {
    /* Slightly brighter on hover */
    background-color: qlineargradient(
        x1: 0, y1: 0, 
        x2: 0, y2: 1, 
        stop: 0 #66bb6a, 
        stop: 1 #43a047);
}

QPushButton:pressed {
    /* Darker when pressed */
    background-color: qlineargradient(
        x1: 0, y1: 0, 
        x2: 0, y2: 1, 
        stop: 0 #43a047, 
        stop: 1 #388e3c);
}

QPushButton:disabled {
	background-color: rgba(44, 44, 44, 50)
}
</string>
