   <property name="styleSheet">
    <string notr="true">color: white;
background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(100, 100, 100, 100),
        stop:1 rgba(30, 30, 30, 220)
    );    
border-radius: 20px;
