    </rect>
   </property>
   <property name="styleSheet">
    <string notr="true">QSlider {
    /* General slider settings */
    min-height: 30px;       /* ensures enough vertical space for the handle */
    margin: 5px 0;          /* some spacing around the slider */
}

/* The groove (track) of the horizontal slider */
QSlider::groove:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #FCA358,         /* start color: lighter orange */
        stop: 1 #D9751C          /* end color: deeper orange */
    );
    height: 8px;               /* thickness of the slider track */
    border-radius: 4px;        /* round the corners */
    margin: 0px;
}

/* The area to the left of the handle (sub-page) */
QSlider::sub-page:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0 #FFDD9E,        /* lighter cream/orange */
        stop: 1 #FCA358
    );
    height: 8px;
    border-radius: 4px;
}

/* The area to the right of the handle (add-page) */
QSlider::add-page:horizontal {
    background: #9B5E24;         /* darker brown-orange */
    height: 8px;
    border-radius: 4px;
}

/* The handle of the horizontal slider */
QSlider::handle:horizontal {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #E6BF9E,         /* top/left: a lighter peach */
        stop: 1 #B27951          /* bottom/right: a deeper brown */
    );
    border: 2px solid #7E5B43;   /* darker outline for a hand-drawn feel */
    width: 20px;                 /* handle width */
    height: 20px;                /* handle height (not strictly needed in horizontal) */
    margin: -6px 0;              /* allows the handle to overlap the groove */
    border-radius: 10px;         /* round handle */
}

/* Handle hover state provides a subtle highlight */
QSlider::handle:horizontal:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #FCD9A4,
        stop: 1 #CA8F66
    );
    border: 2px solid #7E5B43;
}</string>
   </property>
   <property name="orientation">
    <enum>Qt::Orientation::Horizontal</enum>
   </property>
  </widget>
